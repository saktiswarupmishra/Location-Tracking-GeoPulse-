# GeoPulse — Environment Configuration
# ======================================
# Copy to .env and fill in values

# --- Application ---
APP_ENV=development
DEBUG=true

# --- MongoDB (replica set for transactions) ---
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=geopulse

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# --- Twilio (production) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEV_MODE=true

# --- External APIs ---
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute

# --- Location ---
LOCATION_HISTORY_RETENTION_DAYS=7
LOCATION_UPDATE_MIN_INTERVAL_SECONDS=2
LOCATION_STALE_THRESHOLD_SECONDS=60
LOCATION_DELAYED_THRESHOLD_SECONDS=10
LIVE_LOCATION_TTL_SECONDS=3600

# --- WebSocket ---
WS_TICKET_TTL_SECONDS=60

# --- Privacy ---
DEFAULT_SHARE_DURATION=until_stopped

# --- Consent ---
CONSENT_VERSION=1.0

# --- Location Integrity ---
MAX_PLAUSIBLE_SPEED_MPS=340.0
MAX_ACCURACY_METERS=5000.0
